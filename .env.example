# ==============================================================
# SGP CONNECT — ENVIRONMENT CONFIGURATION
# Sanjay Gandhi Polytechnic, Bellary
# ==============================================================

# Firebase Web App Configuration (Required for Live Firebase Mode)
# Obtain these from your Firebase Console -> Project Settings -> General -> Web App
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=optional_analytics_measurement_id

# Google Gemini API Key (Required for Live AI Academic Assistant)
# Obtain from https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# College Geofencing Defaults (Sanjay Gandhi Polytechnic, Bellary)
VITE_COLLEGE_LATITUDE=15.1394
VITE_COLLEGE_LONGITUDE=76.9214
VITE_COLLEGE_RADIUS_METERS=100
