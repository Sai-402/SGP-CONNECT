rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SGP Connect — Fullstack Polytechnic Security Rules
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Development / Campus open access mode for SGP Connect demo
    // You can adjust these rules based on your institutional security requirements
    match /{document=**} {
      allow read, write: if true; // Allows testing and seeding during development
    }

    // Role-based rule templates (for production deployment):
    /*
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || request.auth.token.role == 'admin');
    }
    
    match /attendance_sessions/{sessionId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /attendance_records/{recordId} {
      allow read: if true;
      allow create: if isAuthenticated();
    }
    
    match /study_materials/{materialId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /assignments/{assignmentId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /discussions/{discId} {
      allow read, write: if true;
    }
    
    match /timetable/{slotId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    */
  }
}
